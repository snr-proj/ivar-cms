# Copy this file to .env and fill in your Supabase project's values.
# Find these at: Supabase Dashboard → your project → Project Settings → API

# Public — safe to ship to the browser (Vite bundles anything prefixed VITE_).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — used exclusively by the /api/* serverless functions in
# api/_lib/supabaseAdmin.ts. NEVER prefix this with VITE_, never import it
# from src/, and never commit it. Set it in Vercel under Settings →
# Environment Variables, and in this .env file only for local `vercel dev`.
SUPABASE_SERVICE_ROLE_KEY=

# Never put your database password or any other private key here either —
# only the two public values above and the service_role key (server-only)
# belong in this app.
